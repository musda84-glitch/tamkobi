# TamKobi / NexusHesap — MySQL connection
# Copy to backend/.env (not committed) or export in the process environment.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=tamkobi
MYSQL_DATABASE=tamkobi

# Alternatively:
# MYSQL_URL=mysql://tamkobi:tamkobi@127.0.0.1:3306/tamkobi

# Kept for compatibility with older deploys (same as MYSQL_DATABASE)
DB_NAME=tamkobi

JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
CREDENTIAL_ENCRYPTION_KEY=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://localhost:3000
