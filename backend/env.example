# TamKobi / NexusHesap — MySQL 8.0
# Copy this file to `.env` in the repo root or to `backend/.env`.
# Then run: ./scripts/mysql_harden.sh
# That script replaces the bootstrap passwords below and is the source of truth
# for production. Never commit a real .env.

# App account (DML + CREATE TABLE IF NOT EXISTS). Not root.
DATABASE_URL=mysql://tamkobi:change-me-app@127.0.0.1:3306/tamkobi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=tamkobi
DB_NAME=tamkobi

# Instance admin (docker healthcheck / docker exec). Distinct from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=change-me-root

# Optional least-privilege helpers (created by mysql_harden.sh)
MYSQL_BACKUP_USER=tamkobi_backup
MYSQL_BACKUP_PASSWORD=change-me-backup
MYSQL_MIGRATE_USER=tamkobi_migrate
MYSQL_MIGRATE_PASSWORD=change-me-migrate
MYSQL_DBA_USER=tamkobi_dba
MYSQL_DBA_PASSWORD=change-me-dba

JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8000
