# TamKobi / NexusHesap — MySQL 8.0
# Copy this file to `.env` in the repo root or to `backend/.env`.

# Primary connection string (SQLAlchemy-style mysql:// is also accepted)
DATABASE_URL=mysql://tamkobi:tamkobi@127.0.0.1:3306/tamkobi

# Discrete variables (used if DATABASE_URL / MYSQL_URL is empty)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=tamkobi
MYSQL_DATABASE=tamkobi

# Alias kept for older scripts / docker-compose
DB_NAME=tamkobi
DB_PASSWORD=tamkobi

JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Logging
LOG_DIR=/var/log/tamkobi
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=14
LOG_RETENTION_DAYS=14
LOG_SQL_SLOW_MS=200
LOG_SLOW_REQUEST_MS=1500
LOG_DB_PERSIST=1

# Performance monitor
PERF_INTERVAL_SEC=60
PERF_CPU_LOAD_RATIO=0.85
PERF_MEM_PCT=90
PERF_DISK_PCT=90
PERF_MYSQL_THREADS=25
PERF_CONN_PCT=80
