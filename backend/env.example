# TamKobi — MySQL 8.0
# Copy this file to `.env` in the repo root or to `backend/.env`.

# Primary connection string (SQLAlchemy-style mysql:// is also accepted)
DATABASE_URL=mysql://tamkobi:tamkobi@127.0.0.1:3306/tamkobi

# Discrete variables (used if DATABASE_URL / MYSQL_URL is empty)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=tamkobi
MYSQL_DATABASE=tamkobi

# Alias kept for older scripts / docker-compose
DB_NAME=tamkobi
DB_PASSWORD=tamkobi

JWT_SECRET=change-me
CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:3000,http://localhost:3000

# Image uploads: recompress JPEG/PNG/WebP/GIF (not PDF, not animated GIF).
# High visual quality; store the smallest candidate if it saves >= 5%.
IMAGE_OPTIMIZE=1
IMAGE_MAX_EDGE=2560
IMAGE_JPEG_QUALITY=85
IMAGE_WEBP_QUALITY=82
IMAGE_MIN_SAVINGS=0.05
IMAGE_SKIP_UNDER_BYTES=4096
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://127.0.0.1
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
