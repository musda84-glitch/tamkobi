# TamKobi — MySQL 8.0
# Copy this file to `.env` in the repo root or to `backend/.env`.
# Then run: ./scripts/mysql_harden.sh
# That script replaces the bootstrap passwords below and is the source of truth
# for production. Never commit a real .env.
#
# Fresh server: leave DB empty and open the site — /kurulum collects host,
# database name, site title and admin e-mail. Credentials are stored in
# backend/data/ (not committed). Existing databases with users skip the wizard.

# App account (DML + CREATE TABLE IF NOT EXISTS). Not root.
DATABASE_URL=mysql://tamkobi:change-me-app@127.0.0.1:3306/tamkobi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=change-me-app
MYSQL_DATABASE=tamkobi
DB_NAME=tamkobi

# TLS for the MySQL connection: disabled | required | verify_ca (needs MYSQL_SSL_CA).
# Keep it on whenever the database is not on this host.
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA=

# Instance admin (docker healthcheck / docker exec). Distinct from MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=change-me-root

# Optional least-privilege helpers (created by mysql_harden.sh)
MYSQL_BACKUP_USER=tamkobi_backup
MYSQL_BACKUP_PASSWORD=change-me-backup
MYSQL_MIGRATE_USER=tamkobi_migrate
MYSQL_MIGRATE_PASSWORD=change-me-migrate
MYSQL_DBA_USER=tamkobi_dba
MYSQL_DBA_PASSWORD=change-me-dba

JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:3000,http://localhost:3000

# Image uploads: recompress JPEG/PNG/WebP/GIF (not PDF, not animated GIF).
# High visual quality; store the smallest candidate if it saves >= 5%.
IMAGE_OPTIMIZE=1
IMAGE_MAX_EDGE=2560
IMAGE_JPEG_QUALITY=85
IMAGE_WEBP_QUALITY=82
IMAGE_MIN_SAVINGS=0.05
IMAGE_SKIP_UNDER_BYTES=4096
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://localhost
REACT_APP_BACKEND_URL=http://localhost:8000
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:3000,http://localhost:3000
# 32-byte url-safe Fernet key (local Docker default; replace in production)
CREDENTIAL_ENCRYPTION_KEY=nuqesh1AON2WgDOQc_6wU9uPk5nh4tu6f_x6H8ZAmN8=
EMERGENT_LLM_KEY=
PUBLIC_APP_URL=http://127.0.0.1
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:3000
# Logging
LOG_DIR=/var/log/tamkobi
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=14
LOG_RETENTION_DAYS=14
LOG_SQL_SLOW_MS=200
LOG_SLOW_REQUEST_MS=1500
LOG_DB_PERSIST=1

# Performance monitor
PERF_INTERVAL_SEC=60
PERF_CPU_LOAD_RATIO=0.85
PERF_MEM_PCT=90
PERF_DISK_PCT=90
PERF_MYSQL_THREADS=25
PERF_CONN_PCT=80
