# TamKobi — MySQL 8.0 (copy to `.env`, then run ./scripts/mysql_harden.sh)
# Compose substitutes these into docker-compose.yml. Do not reuse the root password for the app.
DB_NAME=tamkobi
MYSQL_DATABASE=tamkobi
DATABASE_URL=mysql://tamkobi:change-me-app@127.0.0.1:3306/tamkobi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_BACKUP_USER=tamkobi_backup
MYSQL_BACKUP_PASSWORD=change-me-backup
MYSQL_MIGRATE_USER=tamkobi_migrate
MYSQL_MIGRATE_PASSWORD=change-me-migrate
MYSQL_DBA_USER=tamkobi_dba
MYSQL_DBA_PASSWORD=change-me-dba

# --- Outbound mail (Amazon SES). Do not commit real secrets. ---
# Driver order: ynt platform SMTP box (SES) → MAIL_DRIVER fallback.
# console = log only (safe default). smtp = STARTTLS SMTP. ses = boto3 SES API.
MAIL_DRIVER=console
MAIL_FROM=bildirim@tamkobi.com
MAIL_FROM_NAME=TamKobi
MAIL_REPLY_TO=destek@tamkobi.com
MAIL_SES_REGION=eu-central-1
# When MAIL_DRIVER=smtp and no platform box is configured in ynt:
# MAIL_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# SES API (MAIL_DRIVER=ses) uses standard AWS credentials / IAM role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
# SNS bounce/complaint webhook (POST /api/mail/webhooks/ses):
# MAIL_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:ACCOUNT:topic-name
# MAIL_SNS_SKIP_VERIFY=1 only honored when TAMKOBI_ENV=test (ignored in production)
