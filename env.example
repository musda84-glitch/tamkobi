# TamKobi — MySQL 8.0 (copy to `.env`, then run ./scripts/mysql_harden.sh)
# Compose substitutes these into docker-compose.yml. Do not reuse the root password for the app.
DB_NAME=tamkobi
MYSQL_DATABASE=tamkobi
DATABASE_URL=mysql://tamkobi:change-me-app@127.0.0.1:3306/tamkobi
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tamkobi
MYSQL_PASSWORD=change-me-app
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_BACKUP_USER=tamkobi_backup
MYSQL_BACKUP_PASSWORD=change-me-backup
MYSQL_MIGRATE_USER=tamkobi_migrate
MYSQL_MIGRATE_PASSWORD=change-me-migrate
MYSQL_DBA_USER=tamkobi_dba
MYSQL_DBA_PASSWORD=change-me-dba
