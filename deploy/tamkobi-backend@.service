[Unit]
Description=TamKobi FastAPI (uvicorn) on port %i
After=network.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=tamkobi
Group=tamkobi
# WorkingDirectory + ExecStart overridden per-instance by
# /etc/systemd/system/tamkobi-backend@%i.service.d/release.conf
WorkingDirectory=/var/www/tamkobi.com/backend
EnvironmentFile=-/var/www/tamkobi.com/backend/.env
EnvironmentFile=-/var/www/tamkobi.com/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TAMKOBI_BACKGROUND_JOBS=1
# Placeholder — migrate/update writes the real ExecStart in release.conf
ExecStart=/bin/false
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/www/tamkobi.com/backend/data /var/www/tamkobi.com/logs /var/www/tamkobi.com/backups /var/log/tamkobi /var/www/tamkobi.com/backend-releases
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
