# Alt alan adları: app / b2b / ik — kesintisiz dağıtım kökünü paylaşır.
# Kurulum: deploy/nginx/KURULUM.md (§ subdomain).
#
# Önkoşul:
#   - /etc/nginx/conf.d/tamkobi-upstream.conf (tamkobi_api)
#   - snippets/tamkobi-security-headers.conf
#   - spa-routes.map.conf → $tamkobi_spa
#   - Sertifika (tek SAN): certbot certonly --nginx -d app.tamkobi.com -d b2b.tamkobi.com -d ik.tamkobi.com
#     (tüm bloklar /etc/letsencrypt/live/app.tamkobi.com/ kullanır)
#
# ZORUNLU: tamkobi.com / www bloklarına da listen 85.95.240.184:443 ssl http2; ekleyin
# (aşağıdaki IP bind ile aynı egress IP).

# ---------------------------------------------------------------------------
# app.tamkobi.com
# ---------------------------------------------------------------------------
server {
    listen 85.95.240.184:80;
    server_name app.tamkobi.com;
    return 301 https://app.tamkobi.com$request_uri;
}

server {
    listen 85.95.240.184:443 ssl http2;
    server_name app.tamkobi.com;

    # managed by Certbot
    ssl_certificate     /etc/letsencrypt/live/app.tamkobi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.tamkobi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 25m;
    root /var/www/tamkobi.com/frontend-current;
    index index.html;

    include snippets/tamkobi-security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
        access_log off;
    }

    location /api {
        include snippets/tamkobi-security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://tamkobi_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }

    location = /index.html {
        include snippets/tamkobi-security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /static/ {
        include snippets/tamkobi-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        include snippets/tamkobi-security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ @spa_or_404;
    }

    location @spa_or_404 {
        include snippets/tamkobi-security-headers.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        if ($tamkobi_spa = 0) { return 404; }
        rewrite ^ /index.html last;
    }
}

