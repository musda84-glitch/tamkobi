# HTTPS / www→apex — YALNIZCA sertifika oluştuktan sonra kullanın.
# Certbot canlı vhost’u ezmeden bu dosyayı birleştirin (KURULUM.md §C).
#
# Önkoşul:
#   sudo certbot certonly --nginx -d tamkobi.com -d www.tamkobi.com
#   # veya: sudo certbot --nginx -d tamkobi.com -d www.tamkobi.com
#
# SSL sonrası: deploy/nginx/tamkobi.conf içindeki :80 server bloğunun TÜM
# gövdesini (root, location, gzip …) silin ve yalnızca şu yönlendirmeyi bırakın:
#
#   server {
#       listen 80;
#       listen [::]:80;
#       server_name tamkobi.com www.tamkobi.com;
#       return 301 https://tamkobi.com$request_uri;
#   }
#
# Aşağıdaki 443 bloklarını ekleyin (veya bu dosyayı sites-available olarak bağlayın).

# --- HTTP → HTTPS apex (tamkobi.conf :80 yerine) ---
server {
    listen 80;
    listen [::]:80;
    server_name tamkobi.com www.tamkobi.com;
    return 301 https://tamkobi.com$request_uri;
}

# --- www → apex (443) ---
# Not: canlı nginx 1.24 → listen … http2. 1.25.1+ için KURULUM.md’ye bakın.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tamkobi.com;

    ssl_certificate     /etc/letsencrypt/live/tamkobi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tamkobi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://tamkobi.com$request_uri;
}

# --- Ana site (443) — location’lar tamkobi.conf ile aynı ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tamkobi.com;

    ssl_certificate     /etc/letsencrypt/live/tamkobi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tamkobi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 25m;

    root /var/www/tamkobi.com/frontend/build;
    index index.html;

    include snippets/tamkobi-security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    location = /robots.txt {
        include snippets/tamkobi-security-headers.conf;
        try_files $uri =404;
        access_log off;
    }
    location = /sitemap.xml {
        include snippets/tamkobi-security-headers.conf;
        try_files $uri =404;
        access_log off;
    }
    error_page 404 /404.html;
    location = /404.html {
        include snippets/tamkobi-security-headers.conf;
        internal;
    }

    location /api {
        include snippets/tamkobi-security-headers.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        # İstemci XFF’ini ezin — login kilidi bu değere bağlıdır.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
    }

    location ^~ /downloads/ {
        include snippets/tamkobi-security-headers.conf;
        default_type application/zip;
        types { application/zip zip; }
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    location /static/ {
        include snippets/tamkobi-security-headers.conf;
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location / {
        include snippets/tamkobi-security-headers.conf;
        try_files $uri $uri/ @spa_or_404;
    }

    location @spa_or_404 {
        include snippets/tamkobi-security-headers.conf;
        rewrite ^ /index.html last;
    }
}
