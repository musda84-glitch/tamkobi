# HTTPS / www→apex — YALNIZCA sertifika oluştuktan sonra kullanın.
# Certbot canlı vhost’u ezmeden bu blokları mevcut site dosyasına birleştirin
# veya ayrı sites-available dosyası olarak ekleyip include edin.
#
# Önkoşul:
#   sudo certbot certonly --nginx -d tamkobi.com -d www.tamkobi.com
#   # veya mevcut HTTP vhost üzerinde: sudo certbot --nginx -d ...
#
# HTTP (80) sunucusunu şu yönlendirmeye çevirin:
#   return 301 https://tamkobi.com$request_uri;

# --- HTTP → HTTPS apex ---
server {
    listen 80;
    listen [::]:80;
    server_name tamkobi.com www.tamkobi.com;
    return 301 https://tamkobi.com$request_uri;
}

# --- www → apex (443) ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tamkobi.com;

    ssl_certificate     /etc/letsencrypt/live/tamkobi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tamkobi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://tamkobi.com$request_uri;
}

# --- Ana site (443) — location gövdesi tamkobi.conf ile aynı olmalı ---
# Pratik yol: certbot --nginx mevcut HTTP vhost’a SSL ekler; ardından
# www yönlendirmesini ve security-headers include’larını elle doğrulayın.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tamkobi.com;

    ssl_certificate     /etc/letsencrypt/live/tamkobi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tamkobi.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 25m;
    root /var/www/tamkobi.com/frontend/build;
    index index.html;

    include snippets/tamkobi-security-headers.conf;

    # … location blokları için deploy/nginx/tamkobi.conf içeriğini kopyalayın …
}
