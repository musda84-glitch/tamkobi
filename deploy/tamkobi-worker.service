[Unit]
Description=TamKobi background jobs (single process, not in nginx)
After=network.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
# User/Group: migrate/update copies values from the legacy tamkobi-backend.service
# (or root). Same rules as the HTTP template. Do NOT regenerate encryption keys.
User=root
Group=root
# WorkingDirectory + ExecStart overridden by
# /etc/systemd/system/tamkobi-worker.service.d/release.conf
# (release.conf MUST clear ExecStart= before setting the real one).
# This is one unit, not a port template. Blue/green restarts it in place
# (stop, then start). It listens on 127.0.0.1 only and is not an upstream.
WorkingDirectory=/var/www/tamkobi.com/backend
EnvironmentFile=-/var/www/tamkobi.com/backend/.env
EnvironmentFile=-/var/www/tamkobi.com/.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Jobs on. release.conf repeats this and prefixes ExecStart with
# `/usr/bin/env TAMKOBI_BACKGROUND_JOBS=1` so EnvironmentFile cannot disable it.
Environment=TAMKOBI_BACKGROUND_JOBS=1
# Placeholder — migrate/update writes the real ExecStart in release.conf
ExecStart=/bin/false
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/www/tamkobi.com/backend/data /var/www/tamkobi.com/logs /var/www/tamkobi.com/backups /var/log/tamkobi /var/www/tamkobi.com/backend-releases /var/www/tamkobi.com/venvs /data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
