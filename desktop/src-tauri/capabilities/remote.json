{
  "identifier": "tamkobi-remote",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*.tamkobi.com/*",
      "https://tamkobi.com/*"
    ]
  },
  "permissions": [
    "allow-report-session",
    "allow-request-kiosk-exit",
    "allow-complete-kiosk-exit",
    "allow-silent-print"
  ]
}
